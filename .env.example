# Copy to .env for local development. On Netlify, set these under
# Site configuration -> Environment variables.

# REQUIRED - random string, 32+ characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# REQUIRED - Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# REQUIRED in production - https://resend.com API key; verify albibiconstruction.com in Resend
RESEND_API_KEY=
EMAIL_FROM=Albibi Construction <no-reply@albibiconstruction.com>

# Local only: print sign-in codes and emails to the terminal instead of sending them
ALLOW_DEV_LOGIN=false

# Letterhead on the PDFs (all optional)
COMPANY_NAME=Albibi Construction
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=office@albibiconstruction.com
COMPANY_WEBSITE=albibiconstruction.com
COMPANY_LICENSE=
CURRENCY=USD
DEFAULT_TAX_RATE=0
# DEFAULT_TERMS=Payment is due within 30 days of the invoice date. Thank you for your business.
# ESTIMATE_TERMS=This estimate is valid for 30 days. Prices may change if the scope of work changes.

# Optional overrides
# ALLOWED_EMAIL_DOMAIN=albibiconstruction.com
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
